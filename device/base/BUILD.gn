import("//build/ohos.gni")
import("config.gni")

# compile options for gcov
config("hiprofiler_test_config") {
  cflags = [
    "-std=c++17",
    "-fvisibility=hidden",
  ]

  cflags_cc = [
    "-fvisibility-inlines-hidden",
    "-fno-exceptions",
  ]

  ldflags = []

  if (enable_coverage) {
    # clang coverage options:
    if (is_ohos) {
      cflags += [
        "-fprofile-arcs",
        "-ftest-coverage",
      ]
      ldflags += [ "--coverage" ]
    }
    cflags += [
      "-mllvm",
      "-limited-coverage-experimental=true",
      "-fno-use-cxa-atexit",
    ]
  }
}

config("hiprofiler_base_config") {
  defines = []
  if (use_musl && !is_asan) {
    defines += [ "HOOK_ENABLE" ]
  }
  include_dirs = [ "include" ]
}

config("hiprofiler_base_build_config") {
  cflags = [ "-std=c++17" ]
  cflags_cc = [ "-fno-exceptions" ]
}

config("hiprofiler_size_opt_cflags_config") {
  visibility = [ "*:*" ]
  cflags = [
    "-Os",
    "-ffunction-sections",
    "-fdata-sections",
  ]
}

config("hiprofiler_size_opt_config") {
  visibility = [ "*:*" ]
  configs = [ ":hiprofiler_size_opt_cflags_config" ]
  ldflags = [ "-Wl,--gc-sections" ]
}

config("stack_common_public") {
  visibility = [ "*:*" ]
  include_dirs = [ "stack_common" ]
}

config("stack_common_export_config") {
  cflags = [
    "-std=c++17",
    "-fPIC",
  ]
}

# Shared by libstack_common (OHOS) and hiperf host/mingw via external_deps (static lib: headers + TU).
ohos_static_library("stack_common_static") {
  configs = [ ":hiprofiler_size_opt_cflags_config" ]
  visibility = [ "*:*" ]
  part_name = "${OHOS_PROFILER_PART_NAME}"
  subsystem_name = "${OHOS_PROFILER_SUBSYS_NAME}"
  sources = [
    "stack_common/stack_map_query.cpp",
    "stack_common/kernel_map_lookup.cpp",
  ]
  public_configs = [
    ":stack_common_public",
    ":stack_common_export_config",
  ]
  external_deps = [
    "bounds_checking_function:libsec_shared",
  ]
  if (is_ohos) {
    external_deps += [ "faultloggerd:libunwinder" ]
  } else {
    external_deps += [ "faultloggerd:unwinder_host" ]
  }
}

ohos_shared_library("libstack_common") {
  configs = [ ":hiprofiler_size_opt_config" ]
  part_name = "${OHOS_PROFILER_PART_NAME}"
  subsystem_name = "${OHOS_PROFILER_SUBSYS_NAME}"
  visibility = [ "*:*" ]
  deps = [ ":stack_common_static" ]
  public_configs = [
    ":stack_common_public",
    ":stack_common_export_config",
  ]
  external_deps = [
    "bounds_checking_function:libsec_shared",
    "faultloggerd:libunwinder",
  ]
  install_enable = true
  innerapi_tags = [ "platformsdk" ]
}

ohos_static_library("hiprofiler_base_static") {
  configs = [
    ":hiprofiler_base_build_config",
    ":hiprofiler_size_opt_cflags_config",
  ]
  visibility = [ "*:*" ]
  part_name = "${OHOS_PROFILER_PART_NAME}"
  subsystem_name = "${OHOS_PROFILER_SUBSYS_NAME}"
  sources = [
    "src/common.cpp",
    "src/epoll_event_poller.cpp",
    "src/event_notifier.cpp",
    "src/i_semaphore.cpp",
    "src/posix_semaphore.cpp",
    "src/schedule_task_manager.cpp",
    "src/std_semaphore.cpp",
  ]
  public_configs = [ ":hiprofiler_base_config" ]
  external_deps = [
    "bounds_checking_function:libsec_shared",
    "bundle_framework:appexecfwk_base",
    "bundle_framework:appexecfwk_core",
    "c_utils:utils",
    "hisysevent:libhisysevent",
    "init:libbegetutil",
    "ipc:ipc_core",
    "os_account:os_account_innerkits",
    "samgr:samgr_proxy",
  ]
  if (current_toolchain != host_toolchain) {
    defines = [ "HAVE_HILOG" ]
  }
}

ohos_shared_library("libhiprofiler_base") {
  configs = [ ":hiprofiler_size_opt_config" ]
  visibility = [ "*:*" ]
  part_name = "${OHOS_PROFILER_PART_NAME}"
  subsystem_name = "${OHOS_PROFILER_SUBSYS_NAME}"
  deps = [ ":hiprofiler_base_static" ]
  public_configs = [
    ":hiprofiler_test_config",
    ":hiprofiler_base_config",
  ]
  external_deps = [
    "bounds_checking_function:libsec_shared",
    "bundle_framework:appexecfwk_base",
    "bundle_framework:appexecfwk_core",
    "c_utils:utils",
    "hisysevent:libhisysevent",
    "init:libbegetutil",
    "ipc:ipc_core",
    "os_account:os_account_innerkits",
    "samgr:samgr_proxy",
  ]
  install_enable = true
}

ohos_source_set("hiprofiler_base") {
  part_name = "${OHOS_PROFILER_PART_NAME}"
  subsystem_name = "${OHOS_PROFILER_SUBSYS_NAME}"
  sources = [
    "src/common.cpp",
    "src/epoll_event_poller.cpp",
    "src/event_notifier.cpp",
    "src/i_semaphore.cpp",
    "src/posix_semaphore.cpp",
    "src/schedule_task_manager.cpp",
    "src/std_semaphore.cpp",
  ]

  public_configs = [
    ":hiprofiler_test_config",
    ":hiprofiler_base_config",
  ]

  external_deps = [
    "bounds_checking_function:libsec_shared",
    "bundle_framework:appexecfwk_base",
    "bundle_framework:appexecfwk_core",
    "c_utils:utils",
    "hisysevent:libhisysevent",
    "init:libbegetutil",
    "ipc:ipc_core",
    "os_account:os_account_innerkits",
    "samgr:samgr_proxy",
  ]

  if (current_toolchain != host_toolchain) {
    defines = [ "HAVE_HILOG" ]
  }
}

ohos_source_set("hiprofiler_base_cfi") {
  part_name = "${OHOS_PROFILER_PART_NAME}"
  subsystem_name = "${OHOS_PROFILER_SUBSYS_NAME}"
  sources = [
    "src/common.cpp",
    "src/epoll_event_poller.cpp",
    "src/event_notifier.cpp",
    "src/i_semaphore.cpp",
    "src/posix_semaphore.cpp",
    "src/schedule_task_manager.cpp",
    "src/std_semaphore.cpp",
  ]

  public_configs = [
    ":hiprofiler_test_config",
    ":hiprofiler_base_config",
  ]

  sanitize = {
    cfi = true
    cfi_cross_dso = true
    cfi_vcall_icall_only = true
    debug = false
  }

  external_deps = [
    "bounds_checking_function:libsec_shared",
    "bundle_framework:appexecfwk_base",
    "bundle_framework:appexecfwk_core",
    "c_utils:utils",
    "hisysevent:libhisysevent",
    "init:libbegetutil",
    "ipc:ipc_core",
    "os_account:os_account_innerkits",
    "samgr:samgr_proxy",
  ]

  if (current_toolchain != host_toolchain) {
    defines = [ "HAVE_HILOG" ]
  }
}

ohos_source_set("mock_test_source") {
  part_name = "${OHOS_PROFILER_PART_NAME}"
  subsystem_name = "${OHOS_PROFILER_SUBSYS_NAME}"
  sources = [
    "src/test_common.cpp",
  ]
  public_configs = [
    ":hiprofiler_base_config",
  ]
  external_deps = [
    "access_token:libaccesstoken_sdk",
    "access_token:libtokensetproc_shared",
  ]
}
