import("//build/ohos.gni")
import("../../base/config.gni")

config("profiler_apm_config") {
  include_dirs = [
    "include",
    "${OHOS_PROFILER_DIR}/device/base/include",
  ]
  if (current_toolchain != host_toolchain) {
    cflags = [ "-DHAVE_HILOG" ]
  }
}

ohos_source_set("profiler_apm") {
  configs = [ "${OHOS_PROFILER_DIR}/device/base:hiprofiler_size_opt_config" ]
  part_name = "${OHOS_PROFILER_PART_NAME}"
  subsystem_name = "${OHOS_PROFILER_SUBSYS_NAME}"
  sources = [
    "src/zip_storage.cpp",
    "src/storage_factory.cpp",
    "src/htrace_collector.cpp",
    "src/rawheap_collector.cpp",
    "src/jsmap_collector.cpp",
    "src/apm_collect_mgr.cpp",
    "src/file_monitor.cpp",
  ]
  public_configs = [
    ":profiler_apm_config",
    "${OHOS_PROFILER_DIR}/device/base:hiprofiler_test_config",
  ]
  external_deps = [
    "bounds_checking_function:libsec_shared",
    "bundle_framework:appexecfwk_base",
    "bundle_framework:appexecfwk_core",
    "c_utils:utils",
    "safwk:system_ability_fwk",
    "ipc:ipc_core",
    "samgr:samgr_proxy",
    "ability_runtime:app_manager",
    "zlib:libz",
  ]
}