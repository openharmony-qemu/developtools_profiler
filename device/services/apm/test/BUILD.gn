import("//build/test.gni")
import("../../../base/config.gni")

module_output_path = "${OHOS_PROFILER_TEST_MODULE_OUTPUT_PATH}/device"
config("module_private_config") {
  visibility = [ ":*" ]
  if (current_toolchain != host_toolchain) {
    defines = [ "HAVE_HILOG" ]
  }
}

ohos_unittest("apm_ut") {
  module_out_path = module_output_path
  sources = [
    "unittest/apm_collect_mgr_test.cpp",
    "unittest/file_monitor_test.cpp",
    "unittest/htrace_collector_test.cpp",
    "unittest/jsmap_collector_test.cpp",
    "unittest/rawheap_collector_test.cpp",
    "unittest/storage_factory_test.cpp",
    "unittest/zip_storage_test.cpp",
  ]
  include_dirs = [
    "${OHOS_PROFILER_DIR}/device/services/ipc/include",
    "${OHOS_PROFILER_DIR}/interfaces/kits",
  ]
  configs = [
    ":module_private_config",
    "${OHOS_PROFILER_DIR}/device/services/apm:profiler_apm_config",
  ]
  cflags = [
    "-Wno-inconsistent-missing-override",
    "-Dprivate=public",
    "-Dprotected=public",
  ]
  deps = [
    "${OHOS_PROFILER_DIR}/device/base:hiprofiler_base",
    "../:profiler_apm",
  ]
  external_deps = [
    "bounds_checking_function:libsec_shared",
    "c_utils:utils",
    "googletest:gtest",
    "zlib:libz",
  ]
  subsystem_name = "${OHOS_PROFILER_SUBSYS_NAME}"
  part_name = "${OHOS_PROFILER_PART_NAME}"
}

group("unittest") {
  testonly = true
  deps = [ ":apm_ut" ]
}
