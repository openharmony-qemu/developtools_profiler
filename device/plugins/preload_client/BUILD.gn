import("//build/ohos.gni")
import("../../base/config.gni")

config("preload_client_config") {
  defines = [
    "HAVE_LIBUNWIND=0",
    "HAVE_LIBUNWINDER=1",
    "HIPERF_DEBUG",
    "CONFIG_NO_HILOG",
  ]
  defines += [ "target_cpu_${target_cpu}" ]
  defines += [ "PERFORMANCE_DEBUG" ]
  if (!is_asan) {
    defines += [ "HOOK_ENABLE" ]
  }
  visibility = [ ":*" ]
  include_dirs = [ "include" ]
}

ohos_source_set("preload_client_source") {
  use_exceptions = true
  sources = [
    "../../services/ipc/src/socket_context.cpp",
    "../../services/ipc/src/unix_socket_client.cpp",
    "src/preload_client.cpp",
    "src/preload_socket_client.cpp",
  ]
  include_dirs = [
    "./include",
    "../api/include",
    "../api/src",
    "../../base/include/",
    "../native_daemon/include",
    "${OHOS_PROFILER_DIR}/interfaces/kits",
    "${OHOS_PROFILER_DIR}/device/services/ipc/include",
    "${OHOS_PROFILER_DIR}/device/services/shared_memory/include",
  ]
  public_configs = [
    ":preload_client_config",
    "${OHOS_PROFILER_DIR}/device/base:hiprofiler_test_config",
  ]
  deps = [
    "${OHOS_PROFILER_DIR}/device/services/shared_memory:shared_memory_lite",
    "../../base:libhiprofiler_base",
  ]
  external_deps = [
    "bounds_checking_function:libsec_shared",
    "cJSON:cjson",
    "c_utils:utils",
    "ffrt:libffrt",
    "hitrace:libhitracechain",
    "init:libbegetutil",
  ]
  if (hiprofiler_use_libunwinder) {
    external_deps += [ "faultloggerd:libunwinder" ]
  }

  if (current_toolchain != host_toolchain) {
    defines = [ "HAVE_HILOG" ]
    external_deps += [ "faultloggerd:libasync_stack" ]
  }
  subsystem_name = "${OHOS_PROFILER_SUBSYS_NAME}"
  part_name = "${OHOS_PROFILER_PART_NAME}"
  defines += [ "NO_PROTOBUF" ]
  cflags = [
    "-Wno-error=inline-asm",
    "-DPERF_TEST_DATA",
    "-O3",
  ]
}

ohos_shared_library("hiprofiler_preload_client") {
  public_configs = [ ":preload_client_config" ]
  output_name = "hiprofiler_preload_client"
  deps = [ ":preload_client_source" ]
  if (current_toolchain != host_toolchain) {
    defines = [ "HAVE_HILOG" ]
  }
  version_script = "libpreload_client.map"
  install_enable = true
  subsystem_name = "${OHOS_PROFILER_SUBSYS_NAME}"
  part_name = "${OHOS_PROFILER_PART_NAME}"
}
