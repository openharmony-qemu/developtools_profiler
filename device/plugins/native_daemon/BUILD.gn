import("//build/ohos.gni")
import("../../base/config.gni")

config("hook_config") {
  defines = [
    "HAVE_LIBUNWIND=0",
    "HAVE_LIBUNWINDER=1",
    "CONFIG_NO_HILOG",
    "NATIVEDAEMON_USE_CALLSTACK",
  ]
  defines += [ "target_cpu_${target_cpu}" ]
  if (musl_use_jemalloc) {
    defines += [ "USE_JEMALLOC" ]
    if (musl_use_jemalloc_sample) {
      defines += [ "OHOS_ENABLE_SAMPLER" ]
    }
  }
}

config("profiler_sa_config") {
  visibility = [ ":*" ]
  include_dirs = [
    "native_memory_profiler_sa/include",
    "native_memory_profiler_sa/util/include",
    "../../base/include",
  ]
}

config("memory_profiler_client_config") {
  visibility = [ ":*" ]
  include_dirs = [
    "memory_profiler_client/",
    "memory_profiler_client/include",
    "native_memory_profiler_sa/util/include",
  ]
}

ohos_prebuilt_etc("hiprofiler_daemon.cfg") {
  source = "../../etc/hiprofiler_daemon.cfg"
  relative_install_dir = "init"
  part_name = "${OHOS_PROFILER_PART_NAME}"
  subsystem_name = "${OHOS_PROFILER_SUBSYS_NAME}"
}

ohos_shared_library("libmemory_profiler") {
  configs = [
    "${OHOS_PROFILER_DIR}/device/base:hiprofiler_size_opt_config",
    ":hook_config",
    "${OHOS_PROFILER_DIR}/device/base:hiprofiler_test_config",
  ]

  sanitize = {
    cfi = true
    cfi_cross_dso = true
    cfi_vcall_icall_only = true
    debug = false
  }

  include_dirs = [
    "./include",
    "./src",
    "../../base/include",
    "${OHOS_PROFILER_DIR}/device/base/stack_common",
    "../api/include",
    "../api/src",
    "${OHOS_PROFILER_DIR}/interfaces/kits",
    "${OHOS_PROFILER_DIR}/device/services/ipc/include",
    "${OHOS_PROFILER_DIR}/device/services/shared_memory/include",
  ]

  include_dirs += [
    "${OHOS_PROFILER_DIR}/device/plugins/native_daemon/native_memory_profiler_sa/include",
    "${OHOS_PROFILER_DIR}/device/plugins/native_daemon/native_memory_profiler_sa/util/include",
    "${OHOS_PROFILER_DIR}/device/services/profiler_service/src",
  ]

  sources = [
    "../api/src/buffer_writer.cpp",
    "../api/src/command_poller.cpp",
    "../api/src/writer_adapter.cpp",
    "src/dwarf_encoding.cpp",
    "src/get_thread_id.cpp",
    "src/hook_manager.cpp",
    "src/hook_record.cpp",
    "src/hook_record_factory.cpp",
    "src/hook_service.cpp",
    "src/hook_standalone.cpp",
    "src/native_daemon_service.cpp",
    "src/register.cpp",
    "src/smo_map_global.cpp",
    "src/stack_builder.cpp",
    "src/stack_data_repeater.cpp",
    "src/stack_preprocess.cpp",
    "src/symbols_file.cpp",
    "src/utilities.cpp",
    "src/virtual_runtime.cpp",
    "src/virtual_thread.cpp",
  ]
  if (is_ohos) {
    sources += [ "./src/call_stack.cpp" ]
  }

  sources += [
    "${OHOS_PROFILER_DIR}/device/plugins/native_daemon/native_memory_profiler_sa/src/native_memory_profiler_sa_config.cpp",
    "${OHOS_PROFILER_DIR}/device/plugins/native_daemon/native_memory_profiler_sa/src/native_memory_profiler_sa_callback_proxy.cpp",
    "${OHOS_PROFILER_DIR}/device/plugins/native_daemon/native_memory_profiler_sa/src/native_memory_profiler_sa_callback_stub.cpp",
    "${OHOS_PROFILER_DIR}/device/plugins/native_daemon/native_memory_profiler_sa/src/native_memory_profiler_sa_death_recipient.cpp",
    "${OHOS_PROFILER_DIR}/device/plugins/native_daemon/native_memory_profiler_sa/src/native_memory_profiler_sa_service.cpp",
    "${OHOS_PROFILER_DIR}/device/plugins/native_daemon/native_memory_profiler_sa/src/native_memory_profiler_sa_stub.cpp",
    "${OHOS_PROFILER_DIR}/device/services/profiler_service/src/trace_file_helper.cpp",
    "${OHOS_PROFILER_DIR}/device/services/profiler_service/src/trace_file_writer.cpp",
  ]

  deps = [
    ":hiprofiler_daemon.cfg",
    "${OHOS_PROFILER_DIR}/device/services/shared_memory:shared_memory",
    "${OHOS_PROFILER_DIR}/proto_encoder:proto_encoder_source_cfi",
    "${OHOS_PROFILER_DIR}/protos/services:plugin_service_proto_cfi",
    "${OHOS_PROFILER_DIR}/protos/services:profiler_service_all_type_source_cfi",
    "${OHOS_PROFILER_DIR}/protos/types/plugins/native_hook:native_hook_cpp_cfi",
    "${OHOS_PROFILER_DIR}/protos/types/plugins/native_hook:native_hook_cpp_standard_cfi",
    "${OHOS_PROFILER_DIR}/protos/types/plugins/native_hook:native_hook_encoder_cfi",
    "../../base:libstack_common",
    "../../base:libhiprofiler_base",
  ]

  if (hiprofiler_use_libunwind) {
    deps += [ "//third_party/libunwind:unwind_source_${target_cpu}" ]
  }

  external_deps = [
    "ability_runtime:app_manager",
    "ability_base:extractortool",
    "access_token:libaccesstoken_sdk",
    "access_token:libtokensetproc_shared",
    "bounds_checking_function:libsec_shared",
    "cJSON:cjson",
    "c_utils:utils",
    "init:libbegetutil",
    "ipc:ipc_core",
    "openssl:libcrypto_shared",
    "protobuf:protobuf_lite",
    "safwk:system_ability_fwk",
    "samgr:samgr_proxy",
    "zlib:libz",
  ]
  external_deps += [ "faultloggerd:libasync_stack" ]
  defines = [ "ENABLE_HAP_EXTRACTOR" ]
  defines += [ "ENABLE_SA_AUTO_START" ]

  if (hiprofiler_use_libunwinder) {
    external_deps += [ "faultloggerd:libunwinder" ]
  }

  if (current_toolchain != host_toolchain) {
    defines += [ "HAVE_HILOG" ]
  }
  shlib_type = "sa"
  version_script = "libmemory_profiler.versionscript"
  install_enable = true
  subsystem_name = "${OHOS_PROFILER_SUBSYS_NAME}"
  part_name = "${OHOS_PROFILER_PART_NAME}"
}

ohos_executable("native_daemon") {
  output_name = "native_daemon"
  configs = [ "${OHOS_PROFILER_DIR}/device/base:hiprofiler_size_opt_config" ]
  public_configs = [
    ":hook_config",
    "${OHOS_PROFILER_DIR}/device/base:hiprofiler_test_config",
  ]
  sources = [
    "src/main.cpp",
  ]

  include_dirs = [
    "./include",
    "./src",
    "../../base/include",
    "../api/include",
    "../api/src",
    "${OHOS_PROFILER_DIR}/interfaces/kits",
    "${OHOS_PROFILER_DIR}/device/services/ipc/include",
    "${OHOS_PROFILER_DIR}/device/services/shared_memory/include",
  ]

  include_dirs += [
    "${OHOS_PROFILER_DIR}/device/plugins/native_daemon/native_memory_profiler_sa/include",
    "${OHOS_PROFILER_DIR}/device/plugins/native_daemon/native_memory_profiler_sa/util/include",
    "${OHOS_PROFILER_DIR}/device/services/profiler_service/src",
  ]

  deps = [
    ":hiprofiler_daemon.cfg",
    "../../base:libhiprofiler_base",
    ":libmemory_profiler",
  ]

  if (hiprofiler_use_libunwind) {
    deps += [ "//third_party/libunwind:unwind_source_${target_cpu}" ]
  }

  external_deps = [
    "ability_runtime:app_manager",
    "ability_base:extractortool",
    "access_token:libaccesstoken_sdk",
    "access_token:libtokensetproc_shared",
    "bounds_checking_function:libsec_shared",
    "cJSON:cjson",
    "c_utils:utils",
    "hicollie:libhicollie",
    "hisysevent:libhisysevent",
    "init:libbegetutil",
    "ipc:ipc_core",
    "openssl:libcrypto_shared",
    "protobuf:protobuf_lite",
    "safwk:system_ability_fwk",
    "samgr:samgr_proxy",
    "zlib:libz",
  ]
  external_deps += [ "faultloggerd:libasync_stack" ]
  defines = [ "ENABLE_HAP_EXTRACTOR" ]

  if (hiprofiler_use_libunwinder) {
    external_deps += [ "faultloggerd:libunwinder" ]
  }

  if (current_toolchain != host_toolchain) {
    defines += [ "HAVE_HILOG" ]
    external_deps += [ "hilog:libhilog" ]
  }
  use_exceptions = true
  install_enable = true
  subsystem_name = "${OHOS_PROFILER_SUBSYS_NAME}"
  part_name = "${OHOS_PROFILER_PART_NAME}"
}

ohos_executable("native_daemon_client") {
  output_name = "native_daemon_client"
  include_dirs = [
    "../../base/include",
    "${OHOS_PROFILER_DIR}/device/plugins/native_daemon/native_memory_profiler_sa/include",
    "${OHOS_PROFILER_DIR}/device/plugins/native_daemon/native_memory_profiler_sa/util/include",
  ]

  sources = [
    "${OHOS_PROFILER_DIR}/device/plugins/native_daemon/native_memory_profiler_sa/src/native_memory_profiler_sa_client_manager.cpp",
    "${OHOS_PROFILER_DIR}/device/plugins/native_daemon/native_memory_profiler_sa/src/native_memory_profiler_sa_callback_proxy.cpp",
    "${OHOS_PROFILER_DIR}/device/plugins/native_daemon/native_memory_profiler_sa/src/native_memory_profiler_sa_callback_stub.cpp",
    "${OHOS_PROFILER_DIR}/device/plugins/native_daemon/native_memory_profiler_sa/src/native_memory_profiler_sa_config.cpp",
    "${OHOS_PROFILER_DIR}/device/plugins/native_daemon/native_memory_profiler_sa/src/native_memory_profiler_sa_proxy.cpp",
    "${OHOS_PROFILER_DIR}/device/plugins/native_daemon/native_memory_profiler_sa/src/native_memory_profiler_sa_lazyload_callback.cpp",
    "../../base/src/common.cpp",
    "native_daemon_client.cpp",
  ]

  external_deps = [
    "bundle_framework:appexecfwk_base",
    "bundle_framework:appexecfwk_core",
    "c_utils:utils",
    "faultloggerd:libdfx_dumpcatcher",
    "hicollie:libhicollie",
    "hisysevent:libhisysevent",
    "init:libbegetutil",
    "ipc:ipc_core",
    "os_account:os_account_innerkits",
    "safwk:system_ability_fwk",
    "samgr:samgr_proxy",
    "ability_runtime:app_context",
    "storage_service:storage_manager_acl",
  ]

  if (current_toolchain != host_toolchain) {
    defines = [ "HAVE_HILOG" ]
  }
  install_enable = false
  subsystem_name = "${OHOS_PROFILER_SUBSYS_NAME}"
  part_name = "${OHOS_PROFILER_PART_NAME}"
}

ohos_shared_library("libnative_daemon_client") {
  configs = [ "${OHOS_PROFILER_DIR}/device/base:hiprofiler_size_opt_config" ]
  public_configs = [ ":profiler_sa_config" ]
  include_dirs = [
    "../../base/include",
    "${OHOS_PROFILER_DIR}/device/plugins/native_daemon/native_memory_profiler_sa/include",
    "${OHOS_PROFILER_DIR}/device/plugins/native_daemon/native_memory_profiler_sa/util/include",
  ]

  sources = [
    "${OHOS_PROFILER_DIR}/device/plugins/native_daemon/native_memory_profiler_sa/src/native_memory_profiler_sa_client_manager.cpp",
    "${OHOS_PROFILER_DIR}/device/plugins/native_daemon/native_memory_profiler_sa/src/native_memory_profiler_sa_callback_proxy.cpp",
    "${OHOS_PROFILER_DIR}/device/plugins/native_daemon/native_memory_profiler_sa/src/native_memory_profiler_sa_callback_stub.cpp",
    "${OHOS_PROFILER_DIR}/device/plugins/native_daemon/native_memory_profiler_sa/src/native_memory_profiler_sa_config.cpp",
    "${OHOS_PROFILER_DIR}/device/plugins/native_daemon/native_memory_profiler_sa/src/native_memory_profiler_sa_proxy.cpp",
    "${OHOS_PROFILER_DIR}/device/plugins/native_daemon/native_memory_profiler_sa/src/native_memory_profiler_sa_lazyload_callback.cpp",
    "../../base/src/common.cpp",
  ]

  external_deps = [
    "bundle_framework:appexecfwk_base",
    "bundle_framework:appexecfwk_core",
    "c_utils:utils",
    "faultloggerd:libdfx_dumpcatcher",
    "hicollie:libhicollie",
    "hisysevent:libhisysevent",
    "init:libbegetutil",
    "ipc:ipc_core",
    "os_account:os_account_innerkits",
    "safwk:system_ability_fwk",
    "samgr:samgr_proxy",
    "ability_runtime:app_context",
    "storage_service:storage_manager_acl",
  ]

  if (current_toolchain != host_toolchain) {
    defines = [ "HAVE_HILOG" ]
  }

  innerapi_tags = [ "platformsdk" ]
  subsystem_name = "${OHOS_PROFILER_SUBSYS_NAME}"
  part_name = "${OHOS_PROFILER_PART_NAME}"
}

ohos_shared_library("memory_profiler_client") {
  configs = [ "${OHOS_PROFILER_DIR}/device/base:hiprofiler_size_opt_config" ]
  public_configs = [ ":memory_profiler_client_config" ]
  sources = [ "memory_profiler_client/memory_profiler_client_impl.cpp" ]
  deps = [ ":libnative_daemon_client" ]

  external_deps = [
    "c_utils:utils",
    "ipc:ipc_core",
    "samgr:samgr_proxy",
  ]

  if (current_toolchain != host_toolchain) {
    defines = [ "HAVE_HILOG" ]
    external_deps += [ "hilog:libhilog" ]
  }

  innerapi_tags = [ "platformsdk" ]
  subsystem_name = "${OHOS_PROFILER_SUBSYS_NAME}"
  part_name = "${OHOS_PROFILER_PART_NAME}"
}
