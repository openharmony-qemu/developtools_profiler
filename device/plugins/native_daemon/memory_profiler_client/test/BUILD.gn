import("//build/test.gni")
import("../../../../base/config.gni")
import("../../test/native_daemon.gni")

module_output_path = "${OHOS_PROFILER_TEST_MODULE_OUTPUT_PATH}/device"

ohos_unittest("memory_profiler_client_ut") {
  module_out_path = module_output_path
  include_dirs = [
    ".",
  ]
  sources = [
    "unittest/memory_profiler_client_test.cpp",
  ]

  deps = [
    "${OHOS_PROFILER_DIR}/device/plugins/native_daemon:memory_profiler_client",
  ]

  external_deps = [ "faultloggerd:libasync_stack" ]

  if (current_toolchain != host_toolchain) {
    defines = [ "HAVE_HILOG" ]
    external_deps += [ "hilog:libhilog" ]
  }

  subsystem_name = "${OHOS_PROFILER_SUBSYS_NAME}"
  part_name = "${OHOS_PROFILER_PART_NAME}"
}

group("unittest") {
  testonly = true
  deps = [ ":memory_profiler_client_ut" ]
}
