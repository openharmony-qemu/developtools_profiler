set(CMAKE_SYSTEM_NAME Darwin)
set(CMAKE_SYSTEM_PROCESSOR x86_64)
set(CMAKE_C_COMPILER   x86_64-apple-darwin20.4-clang)
set(CMAKE_CXX_COMPILER x86_64-apple-darwin20.4-clang++)
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_OSX_DEPLOYMENT_TARGET "10.15")
set(CMAKE_C_FLAGS "-mmacosx-version-min=10.15" CACHE STRING "" FORCE)
set(CMAKE_CXX_FLAGS "-stdlib=libc++ -mmacosx-version-min=10.15" CACHE STRING "" FORCE)
set(CMAKE_EXE_LINKER_FLAGS "-stdlib=libc++ -lc++ -mmacosx-version-min=10.15" CACHE STRING "" FORCE)
